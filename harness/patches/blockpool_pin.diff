+    # --- suspendserve pin patch (13.1) — methods ---
+    def _ss_log(self, obj) -> None:
+        if not getattr(self, "_ss_events_path", ""):
+            return
+        try:
+            import json as _j, time as _t
+            with open(self._ss_events_path, "a") as f:
+                f.write(_j.dumps({"t": _t.time(), **obj}) + "\n")
+        except Exception:
+            pass
+
+    def _ss_control(self) -> dict:
+        if not getattr(self, "_ss_ctrl_path", ""):
+            return self._ss_ctrl
+        try:
+            import json as _j, os as _o
+            m = _o.path.getmtime(self._ss_ctrl_path)
+            if m != self._ss_ctrl_mtime:
+                with open(self._ss_ctrl_path) as f:
+                    self._ss_ctrl = _j.load(f)
+                self._ss_ctrl_mtime = m
+        except Exception:
+            pass
+        return self._ss_ctrl
+
+    def ss_should_pin(self, req_id: str) -> bool:
+        c = self._ss_control()
+        return (c.get("mode") == "first_n"
+                and len(self.pinned_by_request) < int(c.get("n", 0)))
+
+    def ss_pin_request(self, req_id: str, ordered_blocks) -> None:
+        kept, passthrough = [], []
+        for block in ordered_blocks:
+            block.ref_cnt -= 1
+            if block.ref_cnt == 0 and not block.is_null:
+                if block.block_hash is not None:
+                    self.pinned_block_ids.add(block.block_id)
+                    kept.append(block)
+                else:
+                    passthrough.append(block)
+        self.free_block_queue.prepend_n(passthrough)
+        if kept:
+            self.pinned_by_request[req_id] = kept
+        self._ss_log({"ev": "pin", "req": req_id, "n_blocks": len(kept),
+                      "free_after": self.get_num_free_blocks()})
+
+    def ss_unpin_all(self, reason: str = "reset") -> int:
+        total = 0
+        for req_id, blocks in list(getattr(self, "pinned_by_request", {}).items()):
+            live = [b for b in blocks
+                    if b.block_id in self.pinned_block_ids and b.ref_cnt == 0]
+            self.free_block_queue.append_n(live)
+            for b in live:
+                self.pinned_block_ids.discard(b.block_id)
+            total += len(live)
+            self._ss_log({"ev": "unpin", "req": req_id,
+                          "n_blocks": len(live), "reason": reason})
+        self.pinned_by_request.clear()
+        self.pinned_block_ids.clear()
+        return total
+
+    def ss_residency(self) -> dict:
+        return {r: [sum(1 for b in bl if b.block_id in self.pinned_block_ids),
+                    len(bl)]
+                for r, bl in self.pinned_by_request.items()}
